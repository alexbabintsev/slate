#!/usr/bin/env bash
# Slate CLI - control Slate Chrome extension from the command line.
#
# Setup:
#   1. Get your extension ID from chrome://extensions (developer mode on).
#   2. Set SLATE_EXT_ID in your shell rc, e.g.:
#        export SLATE_EXT_ID="abcdefghijklmnopqrstuvwxyzabcdef"
#   3. Symlink this script onto your PATH:
#        ln -s "$PWD/cli/slate" /usr/local/bin/slate
#   4. Optional: SLATE_BROWSER picks the browser binary (e.g. Microsoft Edge);
#      by default the first Chrome, Chromium or Edge found is used.
#
# Usage:
#   slate open "Work"
#   slate close "Work"
#   slate list

set -euo pipefail

if [[ -z "${SLATE_EXT_ID:-}" ]]; then
  echo "error: SLATE_EXT_ID is not set" >&2
  echo "  export SLATE_EXT_ID=\"<your-extension-id-from-chrome://extensions>\"" >&2
  exit 1
fi

if [[ $# -lt 1 ]]; then
  echo "usage: slate <open|close|list> [project-name]" >&2
  exit 1
fi

ACTION="$1"
PROJECT="${2:-}"

case "$ACTION" in
  open|close|list) ;;
  *) echo "error: unknown action '$ACTION' (expected: open, close, list)" >&2; exit 1 ;;
esac

# Percent-encode every byte outside the RFC 3986 unreserved set, so names with
# #, +, %, ?, / or non-ASCII letters reach the extension unchanged.
encode() {
  local LC_ALL=C s="$1" out="" c i
  for (( i = 0; i < ${#s}; i++ )); do
    c="${s:i:1}"
    case "$c" in
      [a-zA-Z0-9.~_-]) out+="$c" ;;
      # & 0xFF: bash 3.2 (macOS) sign-extends bytes above 0x7F.
      *) out+=$(printf '%%%02X' $(( $(printf '%d' "'$c") & 0xFF ))) ;;
    esac
  done
  printf '%s' "$out"
}

URL="chrome-extension://${SLATE_EXT_ID}/src/cli/cli.html?action=${ACTION}"
if [[ -n "$PROJECT" ]]; then
  URL="${URL}&project=$(encode "$PROJECT")"
fi

# Locate the browser: SLATE_BROWSER if set, else Chrome, Chromium, then Edge.
find_chrome() {
  if [[ -n "${SLATE_BROWSER:-}" ]]; then
    [[ -x "$SLATE_BROWSER" ]] && { echo "$SLATE_BROWSER"; return; }
    command -v "$SLATE_BROWSER" 2>/dev/null && return
    return 1
  fi
  local candidates=(
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
    "/usr/bin/google-chrome"
    "/usr/bin/google-chrome-stable"
    "/usr/bin/chromium"
    "/usr/bin/chromium-browser"
    "/snap/bin/chromium"
    "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"
    "/usr/bin/microsoft-edge"
    "/usr/bin/microsoft-edge-stable"
  )
  for c in "${candidates[@]}"; do
    [[ -x "$c" ]] && { echo "$c"; return; }
  done
  command -v google-chrome 2>/dev/null && return
  command -v chromium 2>/dev/null && return
  command -v microsoft-edge 2>/dev/null && return
  return 1
}

if ! CHROME="$(find_chrome)"; then
  if [[ -n "${SLATE_BROWSER:-}" ]]; then
    echo "error: SLATE_BROWSER '$SLATE_BROWSER' is not an executable" >&2
  else
    echo "error: Chrome, Chromium or Edge not found (set SLATE_BROWSER)" >&2
  fi
  exit 1
fi

# Use --new-window so action runs without disturbing existing windows.
# cli.html closes itself for open/close; for list it stays visible until user closes it.
exec "$CHROME" --new-window "$URL" >/dev/null 2>&1
